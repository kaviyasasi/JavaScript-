let correctOTP = 1234;
let attempts = 0;
let verified = false;

while (attempts < 3) {
    let otp = Number(prompt("Enter OTP:"));
    attempts++;

    if (otp === correctOTP) {
        console.log("OTP verified");
        verified = true;
        break;
    } else {
        console.log("Try again");
    }
}

if (!verified) {
    console.log("Account blocked");
}
