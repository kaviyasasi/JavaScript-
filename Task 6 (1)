console.log("\n===== SEARCH EMPLOYEE USING USER INPUT =====");

let userId = prompt("Enter Employee ID:");

let idNumber = Number(userId);

let userEmployee = searchEmployee(idNumber);

if (userEmployee) {

    console.log("\n===== EMPLOYEE DETAILS =====");

    console.log("ID:", userEmployee.id);
    console.log("Name:", userEmployee.name);
    console.log("Department:", userEmployee.department);
    console.log("Salary:", userEmployee.salary);
    console.log("Experience:", userEmployee.experience);
    console.log("Skills:", userEmployee.skills.join(", "));
    console.log("Joining Date:", userEmployee.joiningDate);

} 
else {

    console.log("No employee found with ID:", idNumber);

}


