// -----------------------------------------------------
// 2. DISPLAY ALL EMPLOYEES - forEach()
// -----------------------------------------------------

console.log("===== ALL EMPLOYEES =====");

employees.forEach(function(employee) {
    console.log(
        "ID:", employee.id,
        "| Name:", employee.name,
        "| Department:", employee.department,
        "| Salary:", employee.salary,
        "| Experience:", employee.experience,
        "| Skills:", employee.skills.join(", ")
    );
});


// -----------------------------------------------------
// 3. FIND EMPLOYEES WITH SALARY > ₹40,000 - filter()
// -----------------------------------------------------

console.log("\n===== SALARY GREATER THAN ₹40,000 =====");

let highSalaryEmployees = employees.filter(function(employee) {
    return employee.salary > 40000;
});

console.log(highSalaryEmployees);


// -----------------------------------------------------
// 4. FIND PARTICULAR EMPLOYEE USING ID - find()
// -----------------------------------------------------

console.log("\n===== FIND EMPLOYEE =====");

let employeeFound = employees.find(function(employee) {
    return employee.id === 103;
});

console.log(employeeFound);


// -----------------------------------------------------
// 5. CALCULATE TOTAL SALARY - reduce()
// -----------------------------------------------------

console.log("\n===== TOTAL SALARY =====");

let totalSalary = employees.reduce(function(total, employee) {
    return total + employee.salary;
}, 0);

console.log("Total Salary = ₹" + totalSalary);


// -----------------------------------------------------
// 6. CHECK SALARY ABOVE ₹1,00,000 - some()
// -----------------------------------------------------

console.log("\n===== SOME() CHECK =====");

let salaryAboveOneLakh = employees.some(function(employee) {
    return employee.salary > 100000;
});

console.log(
    "Is there any employee earning above ₹1,00,000?",
    salaryAboveOneLakh
);


// -----------------------------------------------------
// 7. CHECK EXPERIENCE - every()
// -----------------------------------------------------

console.log("\n===== EVERY() CHECK =====");

let allHaveExperience = employees.every(function(employee) {
    return employee.experience >= 1;
});

console.log(
    "Do all employees have at least 1 year experience?",
    allHaveExperience
);


// -----------------------------------------------------
// 8. SORT EMPLOYEES BY SALARY HIGH TO LOW
// -----------------------------------------------------

console.log("\n===== SALARY HIGH TO LOW =====");

let sortedEmployees = [...employees].sort(function(a, b) {
    return b.salary - a.salary;
});

console.log(sortedEmployees);


// -----------------------------------------------------
// 9. ARRAY MANIPULATION
// push()
// pop()
// unshift()
// shift()
// -----------------------------------------------------

console.log("\n===== ARRAY MANIPULATION =====");

// Add employee using push()
employees.push({
    id: 109,
    name: "Suresh",
    department: "IT",
    salary: 50000,
    experience: 2,
    skills: ["HTML", "CSS"],
    joiningDate: "2023-04-15"
});

console.log("After push:", employees);

// Remove last employee using pop()
let removedLast = employees.pop();

console.log("Removed using pop:", removedLast);

// Add employee at beginning using unshift()
employees.unshift({
    id: 110,
    name: "Anitha",
    department: "HR",
    salary: 48000,
    experience: 3,
    skills: ["HR", "Excel"],
    joiningDate: "2022-02-10"
});

console.log("After unshift:", employees);

// Remove first employee using shift()
let removedFirst = employees.shift();

console.log("Removed using shift:", removedFirst);


// -----------------------------------------------------
// 10. OBJECT DESTRUCTURING
// -----------------------------------------------------

console.log("\n===== OBJECT DESTRUCTURING =====");

let firstEmployee = employees[0];

let {
    name,
    department,
    salary
} = firstEmployee;

console.log("Name:", name);
console.log("Department:", department);
console.log("Salary:", salary);


// -----------------------------------------------------
// 11. ARRAY DESTRUCTURING
// -----------------------------------------------------

