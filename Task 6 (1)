console.log("Skill 1:", skill1);
console.log("Skill 2:", skill2);
console.log("Skill 3:", skill3);


// -----------------------------------------------------
// 12. SPREAD OPERATOR
// -----------------------------------------------------

console.log("\n===== SPREAD OPERATOR =====");

let newEmployeeArray = [...employees];

console.log("New Employee Array:", newEmployeeArray);


// -----------------------------------------------------
// 13. REST OPERATOR
// -----------------------------------------------------

console.log("\n===== REST OPERATOR =====");

function createEmployeeSkills(employeeName, ...skills) {
    return {
        name: employeeName,
        skills: skills
    };
}

let newSkillEmployee = createEmployeeSkills(
    "Rahul",
    "JavaScript",
    "React",
    "Node.js",
    "MongoDB"
);

console.log(newSkillEmployee);


// -----------------------------------------------------
// 14. SALARY CATEGORY
// -----------------------------------------------------

console.log("\n===== SALARY CATEGORY =====");

function getSalaryCategory(salary) {

    if (salary <= 30000) {
        return "Junior";
    } 
    else if (salary <= 60000) {
        return "Mid Level";
    } 
    else {
        return "Senior";
    }
}

employees.forEach(function(employee) {

    console.log(
        employee.name +
        " - ₹" +
        employee.salary +
        " - " +
        getSalaryCategory(employee.salary)
    );

});


// -----------------------------------------------------
// 15. JOINING DATE
// getFullYear()
// getMonth()
// -----------------------------------------------------

console.log("\n===== JOINING DATE DETAILS =====");

employees.forEach(function(employee) {

    let date = new Date(employee.joiningDate);

    console.log(
        employee.name +
        " | Joining Year: " +
        date.getFullYear() +
        " | Joining Month: " +
        (date.getMonth() + 1)
    );

});


// -----------------------------------------------------
// 16. FUNCTION - ADD EMPLOYEE
// -----------------------------------------------------

function addEmployee(employee) {

    employees.push(employee);

    console.log("Employee added successfully!");

}


// -----------------------------------------------------
// 17. FUNCTION - DELETE EMPLOYEE
// -----------------------------------------------------

function deleteEmployee(id) {

    let index = employees.findIndex(function(employee) {
        return employee.id === id;
    });

    if (index !== -1) {

        let deletedEmployee = employees.splice(index, 1);

        console.log("Employee deleted:", deletedEmployee[0]);

    } 
    else {

        console.log("Employee not found!");

    }

}


// -----------------------------------------------------
// 18. FUNCTION - SEARCH EMPLOYEE
// -----------------------------------------------------

function searchEmployee(id) {

    let employee = employees.find(function(employee) {
        return employee.id === id;
    });

    if (employee) {

        console.log("Employee Found:");
        console.log(employee);

    } 
    else {

        console.log("Employee not found!");

    }

    return employee;
}


// -----------------------------------------------------
// 19. FUNCTION - CALCULATE TOTAL SALARY
// -----------------------------------------------------

function calculateTotalSalary() {

    return employees.reduce(function(total, employee) {
        return total + employee.salary;
    }, 0);

}


// -----------------------------------------------------
// 20. FUNCTION - DISPLAY EMPLOYEES
// -----------------------------------------------------

function displayEmployees() {

    console.log("\n===== EMPLOYEE LIST =====");

    employees.forEach(function(employee) {

        console.log(
            employee.id +
            " | " +
            employee.name +
            " | " +
            employee.department +
            " | ₹" +
            employee.salary
        );

    });

}


